    <string name="strategy_title">Bypass strategy</string>
    <string name="strategy_subtitle">The --dpi-desync equivalent, adapted for rootless operation</string>
    <string name="strategy_group_desync">DPI desynchronisation</string>
    <string name="strategy_desync_mode">Desync mode</string>
    <string name="desync_none">Disabled</string>
    <string name="desync_split">split</string>
    <string name="desync_multisplit">multisplit</string>
    <string name="desync_tlsrec">tlsrec</string>
    <string name="desync_multitlsrec">multisplit + tlsrec</string>
    <string name="desync_hostfakesplit">hostfakesplit (HTTP)</string>
    <string name="strategy_desync_hint">The mode defines how the TLS ClientHello is broken into several TCP segments. DPI usually only parses the first segment of a flow, so a split handshake goes unrecognised.</string>
    <string name="strategy_split_pos">Split points</string>
    <string name="strategy_split_pos_hint">The --dpi-desync-split-pos equivalent. Several can be selected.</string>
    <string name="split_pos_1">1 (first byte)</string>
    <string name="split_pos_midsni">midsld (middle of SNI)</string>
    <string name="split_pos_sniend">sniend (after SNI)</string>
    <string name="split_pos_middle">middle (halfway through)</string>
    <string name="split_pos_custom">custom (byte offset)</string>
    <string name="strategy_split_custom_pos">Custom offset, bytes</string>
    <string name="strategy_split_delay">Delay between segments, ms</string>
    <string name="strategy_split_delay_hint">A small delay guarantees the kernel does not coalesce the segments back together.</string>
    <string name="strategy_cutoff">Only process the first chunks (--dpi-desync-cutoff=n)</string>
    <string name="strategy_cutoff_hint">How many of the client\'s first data blocks go through the engine. One is usually enough — that is where the ClientHello lives.</string>
    <string name="strategy_tlsrec_size">Fragment TLS records (--dpi-desync-tlsrec)</string>
    <string name="strategy_tlsrec_hint">A single ClientHello record is repacked into several TLS records of the same type. Legal TLS, but it breaks DPI parsing.</string>
    <string name="strategy_wssize">Slow window start (--wssize)</string>
    <string name="strategy_wssize_hint">Shrinks the advertised window for the first bytes, forcing the server to fragment ServerHello. 0 disables it.</string>
    <string name="strategy_wssize_bytes">Packets with the reduced window</string>
    <string name="strategy_poison">Poison DPI parsing with a decoy record</string>
    <string name="strategy_poison_hint">A complete decoy TLS record with a different domain goes out before the real handshake. The server does not treat it as a handshake, while the filter re-parses the stream and never reaches the real ClientHello: it trips on the decoy, so the blocked domain is not found. Verified against a filter that fully reassembles every segment: 10 of 10 attempts versus 0 of 10 without the decoy.</string>
    <string name="strategy_poison_delay">Delay after decoy, ms</string>
    <string name="strategy_case_mix">Mix letter case in the hostname</string>
    <string name="strategy_case_mix_hint">Changes one letter in the second-level domain. Hostnames are case-insensitive, so the server sees no difference, while filters that look for a substring like youtube.com stop matching. It defeats filters that fully reassemble segments. Turn it off if a site stops loading: some CDNs only answer the canonical case.</string>
    <string name="strategy_wssize_window">Window size, bytes</string>

