    <!-- Стратегия -->
    <string name="strategy_title">Стратегия обхода</string>
    <string name="strategy_subtitle">Аналог --dpi-desync из zapret, адаптированный под работу без root</string>
    <string name="strategy_group_desync">Десинхронизация DPI</string>
    <string name="strategy_desync_mode">Режим десинхронизации</string>
    <string name="desync_none">Отключено</string>
    <string name="desync_split">split</string>
    <string name="desync_multisplit">multisplit</string>
    <string name="desync_tlsrec">tlsrec</string>
    <string name="desync_multitlsrec">multisplit + tlsrec</string>
    <string name="desync_hostfakesplit">hostfakesplit (HTTP)</string>
    <string name="strategy_desync_hint">Режим определяет, как именно TLS ClientHello разбивается на несколько TCP-сегментов. DPI обычно разбирает только первый сегмент потока, поэтому разбитое рукопожатие он не распознаёт.</string>
    <string name="strategy_split_pos">Точки разбиения</string>
    <string name="strategy_split_pos_hint">Аналог --dpi-desync-split-pos. Можно выбрать несколько.</string>
    <string name="split_pos_1">1 (первый байт)</string>
    <string name="split_pos_midsni">midsld (середина SNI)</string>
    <string name="split_pos_sniend">sniend (после SNI)</string>
    <string name="split_pos_middle">middle (середина пакета)</string>
    <string name="split_pos_custom">custom (байт, смещение)</string>
    <string name="strategy_split_custom_pos">Своё смещение, байт</string>
    <string name="strategy_split_delay">Пауза между сегментами, мс</string>
    <string name="strategy_split_delay_hint">Небольшая задержка гарантирует, что ядро не склеит сегменты обратно.</string>
    <string name="strategy_cutoff">Обрабатывать только первые чанки (--dpi-desync-cutoff=n)</string>
    <string name="strategy_cutoff_hint">Сколько первых блоков данных клиента проходит через движок. Обычно достаточно одного — в нём лежит ClientHello.</string>
    <string name="strategy_tlsrec_size">Дробить TLS-записи (--dpi-desync-tlsrec)</string>
    <string name="strategy_tlsrec_hint">Одна запись ClientHello переупаковывается в несколько TLS-записей того же типа. Это легально для TLS, но ломает разбор у DPI.</string>
    <string name="strategy_wssize">Медленный старт окна (--wssize)</string>
    <string name="strategy_wssize_hint">Уменьшает advertised window на первых байтах, заставляя сервер дробить ServerHello. 0 — отключено.</string>
    <string name="strategy_wssize_bytes">Байт с урезанным окном</string>
    <string name="strategy_wssize_window">Размер окна, байт</string>

    <string name="strategy_group_filter">Фильтры потока</string>
    <string name="strategy_tcp_ports">TCP-порты (--wf-tcp / --filter-tcp)</string>
    <string name="strategy_udp_ports">UDP-порты (--wf-udp / --filter-udp)</string>
    <string name="strategy_ports_hint">Формат zapret: 80,443,2053,50000&#8211;50100. Пусто — все порты.</string>
    <string name="strategy_hostlist_mode">Режим списка хостов</string>
    <string name="hostlist_mode_off">Выключен (обрабатывать всё)</string>
    <string name="hostlist_mode_include">Только из списка (--hostlist)</string>
    <string name="hostlist_mode_exclude">Все, кроме списка (--hostlist-exclude)</string>
    <string name="strategy_any_protocol">Обрабатывать неизвестные протоколы (--dpi-desync-any-protocol)</string>

    <string name="strategy_group_udp">UDP и QUIC</string>
    <string name="strategy_block_quic">Блокировать QUIC (UDP/443)</string>
    <string name="strategy_block_quic_hint">Браузеры уходят в QUIC, где обход без root невозможен. Блокировка заставляет их вернуться на TCP/443, где работает split. Google Meet и YouTube загружаются чуть медленнее в первые секунды.</string>
    <string name="strategy_udp_mode">Обработка UDP</string>
    <string name="udp_mode_relay">Релей (пропускать всё)</string>
    <string name="udp_mode_block_filtered">Блокировать только фильтруемые порты</string>
    <string name="udp_mode_block_all">Блокировать весь UDP, кроме DNS</string>
    <string name="strategy_udp_timeout">Таймаут UDP-сессии, сек</string>


