<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="lists/" />
        <!-- DataStore с AppConfig лежит в files/datastore (отдельного домена
             datastore в схеме нет — только file/database/sharedpref/...). -->
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="lists/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
